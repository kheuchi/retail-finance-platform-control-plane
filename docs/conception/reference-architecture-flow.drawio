<mxfile host="drawio"><diagram name="Flow"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Refund fraud: from sources to targets" style="text;html=1;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1800" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Target picture, not built · grey sources · orange event streaming · blue lakehouse · teal ML · pink knowledge (RAG, GraphRAG) · indigo SLM · purple agent · yellow people and targets" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#4B5563;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="26" width="1800" height="20" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1 · Sources&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="230" height="20" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;2 · Event streaming&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="50" width="230" height="20" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;3 · Lakehouse&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="50" width="230" height="20" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;4 · ML&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="50" width="230" height="20" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;5 · Knowledge&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="50" width="230" height="20" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;6 · Agent&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="50" width="230" height="20" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;7 · Targets&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1580" y="50" width="230" height="20" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Store POS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;sales, refunds, voids, overrides&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="220" height="55" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;E-commerce&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;online orders, returns in store&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="155" width="220" height="55" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Payment provider&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;card tokens, chargebacks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="220" height="55" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Loyalty / CRM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;accounts, phones, addresses&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="285" width="220" height="55" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Workforce rota&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;who was on which till (restricted)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="220" height="55" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Case history&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;past cases and outcomes = labels;&lt;br&gt;daily batch to Bronze&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="415" width="220" height="55" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Documents&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;refund policy, playbook, works agreement, case reports&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="220" height="55" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Event backbone&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Kafka / MSK&lt;br&gt;topics: pos-refunds, payments,&lt;br&gt;chargebacks, loyalty-changes,&lt;br&gt;fraud-alerts, decisions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="220" height="130" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Stream processing&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Flink / Spark: features per card and&lt;br&gt;till in seconds; calls the real-time score&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="280" y="230" width="220" height="80" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Document + entity pipeline&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;chunk, embed; SLM extracts&lt;br&gt;entities from case reports&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="280" y="400" width="220" height="70" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;API gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;live reads, quotas, audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="280" y="480" width="220" height="55" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Bronze&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;events as they arrive&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="220" height="45" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Silver&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;cleaned, pseudonymised&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="145" width="220" height="45" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Gold&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;refunds, losses, case outcomes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="220" height="55" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Feature tables&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;offline + online&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="265" width="220" height="45" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Graph tables&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;nodes and edges: cards, accounts,&lt;br&gt;phones, tills, stores&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="320" width="220" height="55" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Certified SQL functions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;the OLAP tools&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="480" width="220" height="55" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Real-time anomaly score&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;every refund, in milliseconds,&lt;br&gt;online endpoint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="220" height="70" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Refund forecast&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;expected refunds per store and day:&lt;br&gt;the baseline to beat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="170" width="220" height="70" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Graph features&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;communities, shared identifiers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="250" width="220" height="55" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;precision, drift&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="315" width="220" height="45" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Model serving&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;scores and forecasts on demand&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="480" width="220" height="55" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Vector index (RAG)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;policy, playbook, works agreement;&lt;br&gt;access rights per reader&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="90" width="220" height="80" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Knowledge graph (GraphRAG)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;entities + links + past case reports;&lt;br&gt;community summaries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1060" y="180" width="220" height="90" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;SLM triage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;small model in our VPC: groups&lt;br&gt;alerts, redacts, closes the obvious&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1320" y="90" width="220" height="80" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Agent (LLM)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;orchestrator + sub-agents&lt;br&gt;plans, calls every tool,&lt;br&gt;writes the case file;&lt;br&gt;computes no numbers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1320" y="200" width="220" height="150" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;figure check, no names, citations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1320" y="370" width="220" height="55" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Investigator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;loss prevention; approves,&lt;br&gt;edits or rejects&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1580" y="90" width="220" height="80" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Case management&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;case file opened (ServiceNow)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1580" y="180" width="220" height="55" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Payment / POS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;refund hold on card tokens&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1580" y="245" width="220" height="55" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Store managers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;alert, no employee names&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1580" y="310" width="220" height="55" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Finance close&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;loss provision for the month&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1580" y="375" width="220" height="55" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Power BI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;reads Gold&lt;/font&gt;" style=