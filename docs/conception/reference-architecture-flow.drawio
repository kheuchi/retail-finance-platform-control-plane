<mxfile host="drawio"><diagram name="Flow"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Margin recovery: from sources to targets" style="text;html=1;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1800" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Target picture, not built · grey sources · orange event streaming · blue lakehouse · teal ML · pink knowledge (RAG, GraphRAG) · indigo SLM · purple agent · yellow people and targets" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#4B5563;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="26" width="1800" height="20" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1 · Sources&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="230" height="20" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;2 · Event streaming&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="50" width="230" height="20" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;3 · Lakehouse&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="50" width="230" height="20" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;4 · ML&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="50" width="230" height="20" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;5 · Knowledge&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="50" width="230" height="20" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;6 · Agent&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="50" width="230" height="20" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;7 · Targets&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1580" y="50" width="230" height="20" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;SAP S/4HANA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;costs, prices, invoices, credit notes, deductions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="220" height="55" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Promotions tool&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;promotion plans, supplier funding&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="155" width="220" height="55" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Store POS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;sales, markdowns, refunds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="220" height="55" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Stock / WMS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;goods receipts, waste, shrink&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="285" width="220" height="55" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Contracts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;rebates, promotion agreements, side letters (PDF)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="220" height="55" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Claims history&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;past claims, disputes, outcomes = labels;&lt;br&gt;daily batch to Bronze&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="415" width="220" height="55" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Supplier portal / EDI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;claim status, disputes, confirmations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="220" height="55" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Event backbone&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Kafka / MSK&lt;br&gt;topics: cost-changes, price-changes,&lt;br&gt;goods-receipts, promotions, sales,&lt;br&gt;margin-signals, decisions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="220" height="130" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Stream processing&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Flink / Spark, rules in seconds:&lt;br&gt;cost up + price unchanged;&lt;br&gt;promotion ended, no claim;&lt;br&gt;claim deadline in 10 days&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="280" y="230" width="220" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Document + entity pipeline&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;chunk, embed; SLM extracts rates,&lt;br&gt;tiers, deadlines from contracts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="280" y="400" width="220" height="70" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;API gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;live reads: SAP, supplier portal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="280" y="480" width="220" height="55" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Bronze&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;events and files as they arrive&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="220" height="45" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Silver&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;cleaned, conformed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="145" width="220" height="45" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Gold&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;margin by store, category, supplier;&lt;br&gt;funding expected vs booked&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="220" height="55" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Feature tables&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;offline + online&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="265" width="220" height="45" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Graph tables&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;supplier, contract, promotion,&lt;br&gt;product, store, claim, owner&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="320" width="220" height="55" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Certified SQL functions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;the OLAP tools&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="480" width="220" height="55" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Margin forecast&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;expected margin without leaks:&lt;br&gt;the baseline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="220" height="70" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Rebate tier forecast&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;purchases to year-end&lt;br&gt;vs each contract tier&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="170" width="220" height="70" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Anomaly scores&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;margin drift, waste, refunds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="250" width="220" height="55" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;accuracy, drift&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="315" width="220" height="45" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Model serving&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;forecasts and scores on demand&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="480" width="220" height="55" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Vector index (RAG)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;contracts, promotion agreements,&lt;br&gt;pricing and claim policy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="90" width="220" height="80" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Knowledge graph (GraphRAG)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;supplier → contract → promotion →&lt;br&gt;products → stores → claims → owner&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1060" y="180" width="220" height="90" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;SLM triage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;ranks hundreds of signals,&lt;br&gt;groups by supplier, drops trivia&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1320" y="90" width="220" height="80" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Agent (LLM)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;orchestrator + sub-agents&lt;br&gt;sizes each leak with tools,&lt;br&gt;explains, drafts claims&lt;br&gt;and close commentary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1320" y="200" width="220" height="150" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;figure check, clause cited,&lt;br&gt;no claim without evidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1320" y="370" width="220" height="55" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Category manager&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;approves supplier claims&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1580" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Pricing team&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;approves price fixes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1580" y="160" width="220" height="55" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Financial controller&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;approves accruals;&lt;br&gt;margin commentary in the close&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1580" y="225" width="220" height="60" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Suppliers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;claims and deduction notices (EDI)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1580" y="305" width="220" height="55" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;SAP (system of record)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;claims, price conditions, accruals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x=