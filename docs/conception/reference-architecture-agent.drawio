<mxfile host="drawio"><diagram name="Agent hub"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="The agent in the middle: one question, every tool, one analysis" style="text;html=1;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1560" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Target picture, not built · grey sources · orange event streaming · blue lakehouse · teal ML · pink knowledge (RAG, GraphRAG) · indigo SLM · purple agent · yellow people and targets" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#4B5563;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="33" width="1560" height="20" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Trigger: margin-signal events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;cost +6% on 140 SKUs since the 3rd, shelf price unchanged;&lt;br&gt;14 promotions ended, no funding claim&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="75" width="380" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Or: the controller asks (close week)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;&quot;Where did we lose margin, why,&lt;br&gt;and how much can we still recover?&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="75" width="340" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;SLM triage (small model, our VPC)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;ranks hundreds of daily signals, groups them by supplier,&lt;br&gt;drops the trivial; only real cases reach the LLM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="600" y="170" width="400" height="65" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Agent (LLM orchestrator)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;plans, delegates to sub-agents:&lt;br&gt;· margin analyst (OLAP, ML)&lt;br&gt;· contract reader (RAG, GraphRAG)&lt;br&gt;· evidence collector (live APIs)&lt;br&gt;· claim and commentary writer&lt;br&gt;computes no numbers; every figure comes from a tool&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="480" height="210" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Event stream&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;What changed?&lt;br&gt;cost and price changes, promotions, receipts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="270" width="340" height="70" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;OLAP (Gold)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Where and how much?&lt;br&gt;margin by store, category, supplier, day&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="370" width="340" height="70" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.38;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;ML&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;What should it have been?&lt;br&gt;margin forecast, rebate tiers, anomalies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="340" height="70" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.61;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;Live APIs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;What is true right now in SAP?&lt;br&gt;conditions, claims sent, credit notes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="570" width="340" height="70" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8400000000000001;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;RAG&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;What does the contract say?&lt;br&gt;rates, tiers, deadlines, clause cited&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="270" width="340" height="70" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;GraphRAG&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;What belongs together, who owns it?&lt;br&gt;supplier → contract → promotion → claim&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1180" y="370" width="340" height="70" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.38;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Deterministic tools&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Exact arithmetic&lt;br&gt;leak = expected − booked, by tool&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="470" width="340" height="70" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.61;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Human-in-the-loop&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Category manager, pricing, controller&lt;br&gt;approve claims, prices, accruals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1180" y="570" width="340" height="70" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.8400000000000001;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="all tool calls through the MCP tool gateway: on behalf of the user, logged" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#5B21B6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="515" width="480" height="20" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;figure check · clause cited · no claim without evidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="600" y="560" width="400" height="55" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Final analysis (margin bridge + actions)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;&quot;Margin −0.2 pt vs forecast = EUR 1.9M. Recoverable now EUR 1.2M:&lt;br&gt;unclaimed promotion funding EUR 610k (14 promotions, 5 suppliers, clauses cited),&lt;br&gt;cost not passed on EUR 380k (140 SKUs), rebate tier at risk EUR 210k.&lt;br&gt;Not recoverable: waste EUR 700k → store operations.&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="540" y="655" width="520" height="120" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Actions after approval&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;claims sent to 5 suppliers · 140 prices fixed ·&lt;br&gt;accruals booked · commentary in the close pack&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="680" width="340" height="80" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Decisions back as events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;approved / rejected / paid + reason →&lt;br&gt;labels for evaluation and retraining&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="680" width="340" height="80" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A16207;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="real cases" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4338CA;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="540"/></Array></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A16207;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>