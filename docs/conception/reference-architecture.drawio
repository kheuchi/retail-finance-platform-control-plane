<mxfile host="drawio"><diagram name="Reference architecture"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Store replenishment: the engine places the routine orders, the agent handles the exceptions" style="text;html=1;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1560" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Target picture, not built · grey sources · orange event streaming · blue lakehouse · teal ML · green replenishment engine (no LLM) · purple agent · yellow targets" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#4B5563;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="33" width="1560" height="20" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1 · Sources&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="240" height="20" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;2 · Event streaming + APIs&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="62" width="240" height="20" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;3 · Lakehouse&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="62" width="240" height="20" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;4 · ML&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="62" width="240" height="20" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;5 · Replenishment engine&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="62" width="240" height="20" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;6 · Targets&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="62" width="240" height="20" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;SAP S/4HANA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;master data, stock, orders&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="104" width="200" height="55" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Store POS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;every sale, every scan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="169" width="200" height="55" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Warehouse system (WMS)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;picks, shipments&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="234" width="200" height="55" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Suppliers (EDI)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;confirmations, ASNs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="364" width="200" height="55" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;External&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;weather, holidays, local events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="299" width="200" height="55" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Documents&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;replenishment policy, supplier contracts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="624" width="200" height="55" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Event backbone&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Kafka (MSK / Confluent) or SAP Event Mesh&lt;br&gt;+ CDC from SAP&lt;br&gt;topics: sales, stock movements,&lt;br&gt;goods receipts, ASNs, order status,&lt;br&gt;agent decisions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="250" y="104" width="230" height="150" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Stream processing&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Flink / Spark Structured Streaming:&lt;br&gt;stock position per store, every few minutes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="274" width="230" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;API gateway (live reads)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;stock on hand, in transit, supplier&lt;br&gt;capacity · quotas, cache, audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="534" width="230" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Document pipeline&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;chunk, embed, version, access rights&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="624" width="230" height="55" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Bronze&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;events landed as they arrive&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="510" y="104" width="240" height="45" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Silver&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;cleaned, deduplicated, conformed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="510" y="159" width="240" height="45" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Gold + semantic layer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;sales and stock history, waste,&lt;br&gt;live stock position (streaming table)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="510" y="214" width="240" height="60" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Feature tables&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;offline for training, online for serving&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="510" y="284" width="240" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Demand forecast&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;nightly batch, every store × SKU,&lt;br&gt;with intervals, beats a baseline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="790" y="104" width="230" height="70" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Online serving&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;scenarios on demand (promotion, weather)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="790" y="184" width="230" height="55" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;accuracy, bias, drift&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="790" y="249" width="230" height="55" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Replenishment engine&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;SAP F&amp;amp;R / RELEX / Blue Yonder&lt;br&gt;forecast + stock + rules → orders&lt;br&gt;&lt;b&gt;~all routine orders, no LLM&lt;/b&gt;&lt;br&gt;millions of order lines a week&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5E9;strokeColor=#15803D;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1060" y="104" width="240" height="120" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Exception events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;stock-out risk, forecast miss,&lt;br&gt;supplier short-ship, order out of range&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5E9;strokeColor=#15803D;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="249" width="240" height="70" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;ERP (system of record)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;purchase orders, store transfers;&lt;br&gt;its own checks apply&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1340" y="104" width="220" height="70" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Suppliers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;orders by EDI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1340" y="184" width="220" height="50" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Power BI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;reads Gold: availability, waste,&lt;br&gt;forecast accuracy, agent acceptance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1340" y="244" width="220" height="60" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Planner / buyer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;gets the proposal in Teams or the&lt;br&gt;replenishment UI; approves, edits&lt;br&gt;or rejects, with a reason&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1340" y="484" width="220" height="95" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7C3AED;dashed=1;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="500" y="409" width="820" height="300" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Exception path: the agent&lt;/b&gt; (hundreds of cases a day, triggered by an event or by a planner's question)" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#5B21B6;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="515" y="414" width="790" height="22" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;1 · OLAP&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;certified Gold SQL functions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="515" y="444" width="240" height="42" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;2 · ML inference&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;forecast table or serving endpoint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="515" y="494" width="240" height="42" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;3 · Live API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;via the API gateway, with as_of&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="515" y="544" width="240" height="42" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;4 · RAG&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;rules and contracts, with citations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="515" y="594" width="240" height="42" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;compute_gap&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;deterministic arithmetic, not the LLM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="515" y="644" width="240" height="42" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Tool gateway (MCP)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;auth on behalf of the user,&lt;br&gt;policy per tool and store,&lt;br&gt;every call logged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="790" y="484" width="230" height="110" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;5 · Agent (LLM)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;orchestrator + sub-agents:&lt;br&gt;plans, calls tools, explains,&lt;br&gt;proposes; computes no numbers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1060" y="444" width="240" height="110" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;figure check, injection filter,&lt;br&gt;proposal as a structured object&lt;/font&