<mxfile host="drawio"><diagram name="Evaluation hub"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Test, evaluate, observe: one loop for data, models, RAG, GraphRAG and agents" style="text;html=1;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1560" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Target picture, not built · grey triggers · blue data · teal ML · pink knowledge · purple agent and the loop · yellow people · orange production signals" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#4B5563;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="33" width="1560" height="20" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Every pull request&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;unit tests, data contracts, guardrail tests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="150" y="75" width="360" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Every release (code, data, prompt, model)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;evaluation on golden sets vs the last version&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="620" y="75" width="360" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Every run in production&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;traces, metrics, quality checks, costs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1090" y="75" width="360" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;The quality loop&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;&lt;b&gt;1 · Test&lt;/b&gt;: does the code do what it should?&lt;br&gt;&lt;b&gt;2 · Evaluate&lt;/b&gt;: is the output good enough&lt;br&gt;on cases with a known answer?&lt;br&gt;&lt;b&gt;3 · Observe&lt;/b&gt;: is it still good in production?&lt;br&gt;&lt;br&gt;same golden sets, thresholds and owners at every step;&lt;br&gt;a release ships only if it beats the last one&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="560" y="280" width="480" height="230" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Data pipes&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;test: transforms, schema contracts&lt;br&gt;eval: quality rules, reconciliation&lt;br&gt;observe: freshness, volume, failures&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="230" width="340" height="80" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;ML models&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;test: features, reproducible training&lt;br&gt;eval: backtest vs baseline, precision&lt;br&gt;observe: input drift, accuracy, age&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="335" width="340" height="80" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.38;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;RAG&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;test: chunking, access rights&lt;br&gt;eval: right passage in top 5, faithful, cited&lt;br&gt;observe: no-answer rate, stale index&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="80" y="440" width="340" height="80" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.61;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;GraphRAG&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;test: entity extraction, no orphan links&lt;br&gt;eval: multi-hop questions vs SQL truth&lt;br&gt;observe: graph freshness, extraction errors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="80" y="545" width="340" height="80" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8400000000000001;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;Agents&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;test: tools, guardrails, prompt injection&lt;br&gt;eval: task success on past cases, tool calls&lt;br&gt;observe: traces, failures, cost, approvals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1180" y="230" width="340" height="80" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Golden sets + judges&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;known questions and answers per layer;&lt;br&gt;code checks first, LLM judge second,&lt;br&gt;a person samples the judge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="335" width="340" height="80" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.38;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Traces + metrics store&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;every step, tool call, token and score&lt;br&gt;(OpenTelemetry), kept with the&lt;br&gt;data, model and prompt version&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="440" width="340" height="80" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.61;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Human review&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;approve / reject / edit, with a reason;&lt;br&gt;reviewers spot-check scores and judges&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="545" width="340" height="80" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.8400000000000001;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Release gate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;tests green · evaluation ≥ last version · no guardrail regressions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="600" y="580" width="400" height="60" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;One dashboard + owned alerts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;data · models · retrieval · agent · cost, green or red;&lt;br&gt;each alert has an owner and a first step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="560" y="690" width="480" height="80" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Feedback becomes new tests&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;rejected drafts, wrong answers, incidents →&lt;br&gt;new cases in the golden sets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="690" width="340" height="80" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Owners act&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;data engineer · ML owner · agent owner;&lt;br&gt;roll back to the last good version&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="690" width="340" height="80" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7280;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7280;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="alert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A16207;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>