:11px' color='#374151'&gt;réceptions, casse, démarque inconnue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="285" width="220" height="55" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Contrats&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;remises, accords promo, avenants (PDF)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="220" height="55" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Historique réclamations&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;réclamations, litiges, issues = labels ;&lt;br&gt;batch quotidien vers Bronze&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="415" width="220" height="55" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Portail fournisseurs / EDI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;statut réclamations, litiges, confirmations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="220" height="55" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Event backbone&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Kafka / MSK&lt;br&gt;topics : cost-changes, price-changes,&lt;br&gt;goods-receipts, promotions, sales,&lt;br&gt;margin-signals, decisions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="220" height="130" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Stream processing&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Flink / Spark, règles en secondes :&lt;br&gt;coût en hausse + prix inchangé ;&lt;br&gt;promo terminée, pas de réclamation ;&lt;br&gt;échéance de réclamation dans 10 j&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="280" y="230" width="220" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Pipeline documents + entités&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;chunk, embed ; le SLM extrait taux,&lt;br&gt;paliers, délais des contrats&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="280" y="400" width="220" height="70" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;API gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;lectures live : SAP, portail fournisseurs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="280" y="480" width="220" height="55" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Bronze&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;événements et fichiers bruts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="220" height="45" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Silver&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;nettoyé, conformé&lt;/font