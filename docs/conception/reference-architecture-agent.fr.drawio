<mxfile host="drawio"><diagram name="Agent au centre"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="L'agent au centre : une question, tous les outils, une seule analyse" style="text;html=1;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1560" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Architecture cible, non construite · gris sources · orange flux d'événements · bleu lakehouse · vert ML · rose connaissance (RAG, GraphRAG) · indigo SLM · violet agent · jaune personnes et cibles" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#4B5563;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="33" width="1560" height="20" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Déclencheur : signaux de marge&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;coût +6 % sur 140 articles depuis le 3, prix en rayon inchangé ;&lt;br&gt;14 promotions terminées, aucune demande de financement&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="75" width="380" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Ou : le contrôleur demande (semaine de clôture)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;« Où avons-nous perdu de la marge, pourquoi,&lt;br&gt;et combien pouvons-nous encore récupérer ? »&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="75" width="340" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Tri par SLM (petit modèle, dans notre VPC)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;classe des centaines de signaux par jour, les regroupe par fournisseur,&lt;br&gt;écarte l'anodin ; seuls les vrais cas vont au LLM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="600" y="170" width="400" height="65" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Agent (LLM orchestrateur)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;planifie, délègue à des sous-agents :&lt;br&gt;· analyste marge (OLAP, ML)&lt;br&gt;· lecteur de contrats (RAG, GraphRAG)&lt;br&gt;· collecteur de preuves (API temps réel)&lt;br&gt;· rédacteur des réclamations et commentaires&lt;br&gt;ne calcule aucun chiffre ; chaque montant vient d'un outil&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="480" height="210" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Flux d'événements&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Qu'est-ce qui a changé ?&lt;br&gt;coûts, prix, promotions, réceptions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="270" width="340" height="70" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;OLAP (Gold)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Où et combien ?&lt;br&gt;marge par magasin, catégorie, fournisseur, jour&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="370" width="340" height="70" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.38;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;ML&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Qu'aurait-elle dû être ?&lt;br&gt;prévision de marge, paliers de remise, anomalies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="340" height="70" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.61;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;API temps réel&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Qu'est-ce qui est vrai maintenant dans SAP ?&lt;br&gt;conditions, réclamations envoyées, avoirs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="570" width="340" height="70" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8400000000000001;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;RAG&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Que dit le contrat ?&lt;br&gt;taux, paliers, délais, clause citée&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="270" width="340" height="70" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;GraphRAG&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Qu'est-ce qui va ensemble, qui en est responsable ?&lt;br&gt;fournisseur → contrat → promotion → réclamation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1180" y="370" width="340" height="70" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.38;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Outils déterministes&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Calcul exact&lt;br&gt;fuite = attendu − comptabilisé, par outil&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="470" width="340" height="70" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.61;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Humain dans la boucle&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Chef de catégorie, pricing, contrôleur&lt;br&gt;valident réclamations, prix, provisions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1180" y="570" width="340" height="70" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.8400000000000001;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Garde-fous&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;contrôle des chiffres · clause citée · pas de réclamation sans preuve&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="600" y="560" width="400" height="55" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Analyse finale (pont de marge + actions)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;« Marge −0,2 pt vs prévision = 1,9 M EUR. Récupérable maintenant : 1,2 M EUR :&lt;br&gt;financement promo non réclamé 610 k EUR (14 promotions, 5 fournisseurs, clauses citées),&lt;br&gt;hausse de coût non répercutée 380 k EUR (140 articles), palier de remise menacé 210 k EUR.&lt;br&gt;Non récupérable : casse et pertes 700 k EUR → opérations magasins. »&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="520" y="655" width="560" height="120" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Actions après validation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;réclamations envoyées à 5 fournisseurs · 140 prix corrigés ·&lt;br&gt;provisions comptabilisées · commentaire dans le dossier de clôture&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="680" width="340" height="80" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Décisions renvoyées en événements&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;validé / rejeté / payé + motif →&lt;br&gt;étiquettes pour l'évaluation et le réentraînement&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="680" width="340" height="80" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A16207;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="vrais cas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4338CA;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="tous les appels d'outils passent par la passerelle MCP : au nom de l'utilisateur, journalisés" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="540"/></Array></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="validé" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A16207;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>