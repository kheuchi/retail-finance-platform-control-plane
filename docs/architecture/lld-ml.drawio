<mxfile host="drawio"><diagram name="LLD ML"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="LLD 5 · ML: fraud detectors and revenue forecast on certified Gold" style="text;html=1;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1" ><mxGeometry x="20" y="5" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c2" value="retail-finance-data-products · job train_models · runs as finance-pipeline-runner on our VPC cluster" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#4B5563;align=left;verticalAlign=middle;" vertex="1" parent="1" ><mxGeometry x="20" y="33" width="1100" height="20" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;ops.gold_certification&lt;/b&gt;&lt;br&gt;latest run must be certified&lt;br&gt;else: job refuses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontSize=12;fontStyle=0;dashed=0;fontColor=#1F2937;align=center;verticalAlign=middle;arcSize=6;spacing=6;opacity=100;" vertex="1" parent="1" ><mxGeometry x="20" y="90" width="220" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Certified Gold&lt;/b&gt;&lt;br&gt;refunds · margin&lt;br&gt;daily_revenue · budget_variance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontSize=12;fontStyle=0;dashed=0;fontColor=#713F12;align=center;verticalAlign=middle;arcSize=6;spacing=6;opacity=100;" vertex="1" parent="1" ><mxGeometry x="20" y="200" width="220" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Answer key&lt;/b&gt; (synthetic only)&lt;br&gt;_ground_truth/anomalies.csv&lt;br&gt;used to &lt;b&gt;score&lt;/b&gt;, never to train" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontSize=12;fontStyle=0;dashed=1;fontColor=#1F2937;align=center;verticalAlign=middle;arcSize=6;spacing=6;opacity=100;" vertex="1" parent="1" ><mxGeometry x="20" y="330" width="220" height="70" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7F5;strokeColor=#FF3621;fontSize=12;fontStyle=0;dashed=0;fontColor=#1F2937;align=center;verticalAlign=middle;arcSize=6;spacing=6;opacity=100;" vertex="1" parent="1" ><mxGeometry x="280" y="70" width="640" height="470" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Job train_models&lt;/b&gt; · single node m6gd.large · spot · policy finance-jobs" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#FF3621;align=left;verticalAlign=middle;" vertex="1" parent="1" ><mxGeometry x="295" y="78" width="600" height="20" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Cashier refund detector&lt;/b&gt;&lt;br&gt;Isolation Forest, unsupervised&lt;br&gt;features vs the cashier's store peers&lt;br&gt;flags ≈ 0.5% (review queue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF3621;fontSize=12;fontStyle=0;dashed=0;fontColor=#1F2937;align=left;verticalAlign=middle;arcSize=6;spacing=6;opacity=100;" vertex="1" parent="1" ><mxGeometry x="300" y="110" width="290" height="95" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Store margin detector&lt;/b&gt;&lt;br&gt;Isolation Forest, unsupervised&lt;br&gt;margin and discount vs the store's&lt;br&gt;own months 4-12 back, net of chain-wide moves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF3621;fontSize=12;fontStyle=0;dashed=0;fontColor=#1F2937;align=left;verticalAlign=middle;arcSize=6;spacing=6;opacity=100;" vertex="1" parent="1" ><mxGeometry x="610" y="110" width="290" height="95" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Revenue forecast&lt;/b&gt;&lt;br&gt;gradient boosting vs seasonal-naive baseline&lt;br&gt;backtest on the last 3 complete months&lt;br&gt;&lt;b&gt;the winner ships&lt;/b&gt; (today: the baseline)" style="rounded=1;whiteSpace=wrap;html=1;fil