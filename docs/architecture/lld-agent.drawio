<mxfile host="drawio"><diagram name="LLD 6 agent"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="LLD 6 · Agent: who runs as whom, across GitHub, Google, Databricks and AWS" style="text;html=1;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1560" height="30" as="geometry"/></mxCell><mxCell id="c2" value="As built 2026-10-07 (D-032) · keyless between clouds · the only secrets are two Databricks OAuth clients (GCP Secret Manager, AWS Secrets Manager)" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#4B5563;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="33" width="1560" height="20" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6B7280;dashed=1;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="280" height="790" as="geometry"/></mxCell><mxCell id="c4" value="GitHub" style="text;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#6B7280;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="78" width="250" height="24" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0F766E;dashed=1;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="520" height="790" as="geometry"/></mxCell><mxCell id="c6" value="Google Cloud · europe-west1" style="text;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#0F766E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="335" y="78" width="490" height="24" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2563EB;dashed=1;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="860" y="70" width="340" height="790" as="geometry"/></mxCell><mxCell id="c8" value="Databricks" style="text;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#2563EB;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="875" y="78" width="310" height="24" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;dashed=1;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1220" y="70" width="360" height="790" as="geometry"/></mxCell><mxCell id="c10" value="AWS · eu-central-1" style="text;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#D97706;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1235" y="78" width="330" height="24" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;data repo · main&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;agent code, pinned versions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="240" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;agent-gcp.yml&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;deploy needs approval;&lt;br&gt;OIDC token: repo id + main&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="240" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Workload Identity Federation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;pool GitHub Actions: only this repo,&lt;br&gt;only main&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="220" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Gemini 3.8 Flash&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Vertex AI EU endpoint;&lt;br&gt;no training on our data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="600" y="130" width="220" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;SA finance-agent-deployer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;aiplatform.user · staging bucket ·&lt;br&gt;may act as the runtime SA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="240" width="220" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Agent Engine (Agent Runtime)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Deep Agents supervisor + 3 sub-agents&lt;br&gt;runs as &lt;b&gt;SA finance-month-end-agent&lt;/b&gt;&lt;br&gt;aiplatform.user · logWriter · cloudtrace.agent · reads one secret&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="340" y="340" width="480" height="120" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Databricks OAuth client of&lt;br&gt;finance-month-end-agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="220" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Cloud Logging + Trace&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;agent logs and traces&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="600" y="520" width="220" height="70" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Unity Catalog&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;finance.agent functions run with their&lt;br&gt;owner's rights: the agent sees only&lt;br&gt;what they return (no table grants)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="300" height="90" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Managed MCP server&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;HTTPS, OAuth M2M, as &lt;b&gt;SP finance-month-end-agent&lt;/b&gt;:&lt;br&gt;EXECUTE on 6 finance.agent functions;&lt;br&gt;refuses uncertified Gold&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="880" y="375" width="300" height="95" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Agent tables&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;finance.agent.drafts ·&lt;br&gt;finance.agent.approvals (controllers only) ·&lt;br&gt;gold.close_commentary (Power BI)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="620" width="300" height="90" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Controller (finance-controllers)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;approves a draft = one row&lt;br&gt;in finance.agent.approvals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="880" y="760" width="300" height="70" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;STS AssumeRoleWithWebIdentity&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Google ID token: sub = runtime SA,&lt;br&gt;aud = retail-finance-agent-gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1240" y="320" width="320" height="70" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Role …-agent-gcp&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;InvokeGateway on the channels gateway only; 1 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1240" y="430" width="320" height="60" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;AgentCore Gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;tools: submit_draft · list_drafts · send_approved&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1240" y="530" width="320" height="60" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Lambda channels&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;figure check · approval check;&lt;br&gt;SQL Statement API as &lt;b&gt;SP finance-close-notifier&lt;/b&gt;&lt;br&gt;(secret in AWS Secrets Manager)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1240" y="630" width="320" height="8