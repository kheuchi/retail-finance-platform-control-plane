<mxfile host="drawio"><diagram name="HLD"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="HLD · As built: from the controller's question to the data, and everything around it" style="text;html=1;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1800" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Updated 2026-10-29 · ①-⑦ = one month-end run · grey people and GitHub · teal Google · purple agent · orange AWS · blue Databricks · yellow outputs" style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#4B5563;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="33" width="1800" height="20" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6B7280;dashed=1;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="200" height="600" as="geometry"/></mxCell><mxCell id="c4" value="People" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#6B7280;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="32" y="74" width="176" height="22" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6B7280;dashed=1;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="240" y="70" width="240" height="600" as="geometry"/></mxCell><mxCell id="c6" value="GitHub" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#6B7280;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="252" y="74" width="216" height="22" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0F766E;dashed=1;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="500" y="70" width="300" height="600" as="geometry"/></mxCell><mxCell id="c8" value="Google Cloud · europe-west1" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#0F766E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="512" y="74" width="276" height="22" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;dashed=1;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="820" y="70" width="280" height="600" as="geometry"/></mxCell><mxCell id="c10" value="Tools and gateways (AWS + Databricks)" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#D97706;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="832" y="74" width="256" height="22" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2563EB;dashed=1;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1120" y="70" width="500" height="600" as="geometry"/></mxCell><mxCell id="c12" value="Databricks workspace · our AWS VPC, eu-central-1" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#2563EB;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1132" y="74" width="476" height="22" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#A16207;dashed=1;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1640" y="70" width="180" height="600" as="geometry"/></mxCell><mxCell id="c14" value="Outputs" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#A16207;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1652" y="74" width="156" height="22" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;① starts a run for a close&lt;br&gt;month (GitHub workflow&lt;br&gt;or script)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="35" y="130" width="170" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Engineers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;pull requests only;&lt;br&gt;no console changes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="35" y="270" width="170" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;3 repos&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;control plane · infra · data&lt;br&gt;main protected (PR + checks)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="255" y="130" width="210" height="80" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;CI on every PR · gated deploy&lt;br&gt;(approval) · nightly config drift ·&lt;br&gt;release tag on merge (6.3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="255" y="245" width="210" height="110" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Keyless deploy identities&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;OIDC → AWS github-plan / -deploy&lt;br&gt;WIF → GCP finance-agent-deployer&lt;br&gt;OAuth → Databricks&lt;br&gt;finance-data-deployer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="255" y="390" width="210" height="120" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Agent Engine (Vertex AI)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Deep Agents supervisor + 3 sub-agents&lt;br&gt;we ship code + requirements;&lt;br&gt;Vertex builds the container ·&lt;br&gt;scales to zero · SA finance-month-end-agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="515" y="130" width="270" height="120" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Gemini 3.8 Flash&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;④ plans and drafts · Vertex EU endpoint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="515" y="290" width="270" height="60" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Databricks OAuth client of the agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="515" y="380" width="270" height="55" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Cloud Logging&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;runtime logs (tracing not switched on)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="515" y="465" width="270" height="55" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Databricks managed MCP&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;② 6 Unity Catalog functions;&lt;br&gt;Gold certification checked first;&lt;br&gt;agent may EXECUTE only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="835" y="130" width="250" height="90" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;AgentCore Gateway (MCP)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;⑤ submit_draft · list_drafts ·&lt;br&gt;send_approved · IAM auth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="835" y="270" width="250" height="75" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Lambda channels&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;figure check · approval check&lt;br&gt;as SP finance-close-notifier&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="835" y="380" width="250" height="80" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Amazon SES&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;⑦ email (stand-in for Teams)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="835" y="500" width="250" height="60" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;SQL warehouse&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;③ runs the functions on Gold;&lt;br&gt;returns aggregates only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1135" y="130" width="220" height="80" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Agent tables&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;drafts · approvals ·&lt;br&gt;gold.close_commentary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1385" y="130" width="220" height="80" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Pipeline job (daily orchestrator)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;generator → landing volume → Auto Loader → Bronze → Silver → Gold&lt;br&gt;quality gates → Gold certified (ops.gold_certification)&lt;br&gt;runs as finance-pipeline-runner · failure email&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1135" y="250" width="470" height="110" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;ML job&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;2 Isolation Forest detectors ·&lt;br&gt;forecast vs baseline · PSI drift&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1135" y="395" width="220" height="90" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;MLflow + UC finance.ml&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;experiments, registered models;&lt;br&gt;scores and forecast back to Gold&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1385" y="395" width="220" height="90" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Unity Catalog · catalog finance on our S3 (dbx-uc)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;raw · bronze · silver · gold · ops · ml · agent&lt;br&gt;grants to groups only · lineage · consumers read certified Gold only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2563EB;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1135" y="520" width="470" height="80" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Controller approves&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;⑥ one row in&lt;br&gt;finance.agent.approvals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1655" y="130" width="150" height="80" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Power BI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;reads Gold and&lt;br&gt;close_commentary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1655" y="260" width="150" height="80" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;CFO pack&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;approved commentary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1655" y="380" width="150" height="70" as="geometry"/></mxCell><mxCell id="c37" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A16207;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="112"/><mxPoint x="650" y="112"/></Array></mxGeometry></mxCell><mxCell id="c38" value="PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7280;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7280;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="⑤ ID token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="approved only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="404"/><mxPoint x="1110" y="230"/><mxPoint x="1495" y="230"/></Array></mxGeometry></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A16207;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F766E;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="Gold" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;fontSize=10;fontColor=#374151;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="&lt;b&gt;Identity and access&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;people in groups: finance-controllers (approve), finance-analysts (read Gold) · CI: OIDC / WIF / OAuth, no stored cloud keys · run time: finance-pipeline-runner, finance-month-end-agent (EXECUTE functions only), finance-close-notifier, role …-agent-gcp (InvokeGateway only) · root never used, break-glass alarmed · LLD 2, LLD 6&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="1800" height="50" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Compute&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Databricks classic job clusters in our VPC (policy finance-jobs, single node m6gd.large, spot) · SQL warehouse for the agent's functions · serverless egress restricted to dbx-uc · Vertex Agent Engine (scale to zero) · Lambda · nothing always on&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="748" width="1800" height="50" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Network&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;VPC 10.20.0.0/16 without internet gateway or NAT · PrivateLink to the Databricks control plane · S3 gateway endpoint · agent hops Google → Databricks and Google → AWS cross the internet with TLS (D-032) · LLD 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="806" width="1800" height="50" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Observability&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;recorded: CloudTrail + alarms (root, break-glass), VPC flow logs, budgets, job failure email, ops.dq_results, ops.gold_certification, ops.model_drift, nightly config drift, ops.agent_runs (tokens, cost), Cloud Logging · missing: dashboard, alerts, tracing (story 6.4) · LLD 4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="864" width="1800" height="50" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Governance and cost&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#374151'&gt;Unity Catalog grants and lineage · synthetic data only · EU regions only (eu-central-1, europe-west1, Gemini EU) · every change by PR · AWS budget USD 50/month, Databricks budget alerts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=12;fontColor=#111827;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="922" width="1800" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>