---
/* Shared page frame: fonts, the site styles, nav and footer. Each page adds its own stylesheet. */
import "../styles/site.css";
import { url } from "../lib/url";

interface Props { title: string; description: string; page: "home" | "landscape" | "tools" | "architecture"; footer: string; narrow?: boolean }
const { title, description, page, footer, narrow = false } = Astro.props;
const links: [Props["page"], string, string][] = [
  ["home", "Home", url("index.html")],
  ["landscape", "Landscape", url("landscape/platform-landscape.html")],
  ["tools", "Tools", url("landscape/tools.html")],
  ["architecture", "Architecture", url("architecture/architecture.html")],
];
const wide = narrow ? "max-width:1100px" : undefined;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
</head>
<body>
<nav class="site" aria-label="Site"><div class="wrap">
  <span class="brand">Retail Finance Platform</span>
  {links.map(([k, label, href]) => <a href={href} aria-current={k === page ? "page" : undefined}>{label}</a>)}
  <a href="https://github.com/kheuchi/retail-finance-platform-control-plane">Docs on GitHub</a>
  <span class="preview">v2 preview · <a href="/retail-finance-platform-control-plane/">current site</a></span>
</div></nav>
{Astro.slots.has("header") && <header class="top"><div class="wrap" style={wide}>
  <slot name="header" />
</div></header>}
<slot />
<footer class="site"><div class="wrap" style={wide}>{footer}</div></footer>
</body>
</html>
<style is:global>
  nav.site .preview { margin-left: auto; font-size: 12px; opacity: .8 }
  nav.site .preview a { font-size: 12px }
</style>
